# ============================================================
# 压力管理 LLM 项目 - 环境变量模板
# 复制为 .env 并填入实际值
# ============================================================

# ---- HuggingFace ----
HF_HOME=./cache/huggingface
HF_TOKEN=hf_your_token_here
HF_ENDPOINT=https://huggingface.co

# ---- W&B 实验追踪 ----
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=stress-management-llm
WANDB_ENTITY=your_team_name

# ---- MLflow ----
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=stress-management-llm

# ---- 模型下载镜像（可选） ----
# HF_ENDPOINT=https://hf-mirror.com  # 国内镜像

# ---- API Keys（用于教师模型评审） ----
# OPENAI_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
